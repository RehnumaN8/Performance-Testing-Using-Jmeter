          <BeanShellPreProcessor guiclass="TestBeanGUI" testclass="BeanShellPreProcessor" testname="BeanShell PreProcessor" enabled="true">
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <boolProp name="resetInterpreter">false</boolProp>
            <stringProp name="script">long time = System.currentTimeMillis();

String phone = &quot;015&quot; + String.valueOf(time).substring(5,13); // always 11 digit

String name = &quot;Customer&quot; + time;

String email = &quot;customer&quot; + time + &quot;@test.com&quot;; // no underscore

String nid = String.valueOf(time).substring(3,13);

vars.put(&quot;phone_number&quot;, phone);
vars.put(&quot;name&quot;, name);
vars.put(&quot;email&quot;, email);
vars.put(&quot;nid&quot;, nid);
vars.put(&quot;role&quot;, &quot;Customer&quot;);</stringProp>
          </BeanShellPreProcessor>
          <hashTree/>
          <BeanShellPostProcessor guiclass="TestBeanGUI" testclass="BeanShellPostProcessor" testname="BeanShell PostProcessor" enabled="true">
            <boolProp name="resetInterpreter">false</boolProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="script">props.put(&quot;cust2_phone&quot;, vars.get(&quot;phone_number&quot;));
props.put(&quot;cust2_email&quot;, vars.get(&quot;cust2_email&quot;));
props.put(&quot;cust2_pass&quot;, &quot;123456&quot;);</stringProp>
          </BeanShellPostProcessor>
          <hashTree/>
        </hashTree>
